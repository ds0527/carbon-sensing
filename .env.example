# 수집용 키 (1단계)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
TAVILY_API_KEY=

# LLM 설정 (2단계에서 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=
MAX_TOKENS_PER_RUN=200000

# 수집 시 보내는 User-Agent. HTTP 헤더는 ASCII만 되므로 한글을 넣지 마세요.
USER_AGENT=CarbonSensingBot/0.1 (carbon-neutrality trend research; contact: your@email.com)
